<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Smart Mill - Admin Portal</title>
  <!-- Google Fonts & FontAwesome Icons -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <style>
    /* CSS DESIGN SYSTEM */
    :root {
      --bg-main: #F3F5F3;
      --primary-green: #0D6535;
      --light-green: #E2F4E8;
      --border-color: #E1E6E1;
      --text-dark: #1E293B;
      --text-muted: #64748B;
      --card-bg: #FFFFFF;
      --red-alert: #D9383A;
      --red-bg: #FEE2E2;
      --yellow-alert: #D97706;
      --yellow-bg: #FEF3C7;
      --blue-info: #2563EB;
      --blue-bg: #DBEAFE;
      --radius: 12px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    body {
      background-color: var(--bg-main);
      color: var(--text-dark);
      display: flex;
      height: 100vh;
      overflow: hidden;
      font-size: 14px;
    }

    /* LOGIN SCREEN */
    #login-screen {
      position: fixed;
      inset: 0;
      background: var(--bg-main);
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .login-card {
      background: white;
      padding: 40px;
      border-radius: var(--radius);
      border: 1px solid var(--border-color);
      width: 100%;
      max-width: 400px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.05);
    }

    .login-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 24px;
    }

    .login-brand i {
      font-size: 28px;
      color: var(--primary-green);
    }

    .login-brand h1 {
      font-size: 20px;
      font-weight: 700;
      color: var(--primary-green);
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      margin-bottom: 6px;
      font-weight: 500;
      color: var(--text-dark);
    }

    .form-group input, .form-group select, .form-group textarea {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      outline: none;
      font-size: 14px;
      transition: border 0.2s;
    }

    .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
      border-color: var(--primary-green);
    }

    /* SIDEBAR */
    aside {
      width: 260px;
      background-color: var(--card-bg);
      border-right: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      flex-shrink: 0;
    }

    .sidebar-header {
      padding: 24px 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      border-bottom: 1px solid var(--border-color);
    }

    .sidebar-header i {
      font-size: 24px;
      color: var(--primary-green);
    }

    .sidebar-header h2 {
      font-size: 18px;
      font-weight: 700;
      color: var(--primary-green);
    }

    .nav-group {
      padding: 16px 12px;
    }

    .nav-label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--text-muted);
      letter-spacing: 0.5px;
      padding: 0 12px 8px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px;
      color: var(--text-muted);
      text-decoration: none;
      border-radius: 8px;
      font-weight: 500;
      margin-bottom: 4px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .nav-item-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .nav-item:hover {
      background-color: var(--bg-main);
      color: var(--text-dark);
    }

    .nav-item.active {
      background-color: var(--light-green);
      color: var(--primary-green);
      font-weight: 600;
    }

    .badge-count {
      background: var(--red-alert);
      color: white;
      font-size: 11px;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 12px;
    }

    /* MAIN LAYOUT */
    main {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    header {
      height: 70px;
      background-color: var(--card-bg);
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
    }

    .header-title {
      font-size: 20px;
      font-weight: 700;
      color: var(--text-dark);
    }

    .admin-pill {
      display: flex;
      align-items: center;
      gap: 12px;
      background: var(--bg-main);
      padding: 6px 14px;
      border-radius: 30px;
      border: 1px solid var(--border-color);
    }

    .avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--primary-green);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 12px;
    }

    .content-area {
      flex: 1;
      padding: 32px;
      overflow-y: auto;
    }

    /* CONTENT VIEWS */
    .view-page {
      display: none;
    }
    .view-page.active {
      display: block;
    }

    /* CARDS & TABLES */
    .card {
      background: var(--card-bg);
      border-radius: var(--radius);
      border: 1px solid var(--border-color);
      padding: 24px;
      margin-bottom: 24px;
    }

    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-bottom: 24px;
    }

    .metric-card {
      background: var(--card-bg);
      border-radius: var(--radius);
      border: 1px solid var(--border-color);
      padding: 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .metric-card.highlight {
      border-left: 4px solid var(--yellow-alert);
    }

    .metric-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: var(--text-muted);
      font-size: 13px;
      font-weight: 500;
    }

    .metric-val {
      font-size: 28px;
      font-weight: 700;
      margin-top: 10px;
      color: var(--text-dark);
    }

    .metric-sub {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 4px;
    }

    /* BUTTONS */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 16px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 13px;
      cursor: pointer;
      border: 1px solid transparent;
      transition: all 0.2s;
    }

    .btn-primary {
      background-color: var(--primary-green);
      color: white;
    }
    .btn-primary:hover {
      opacity: 0.9;
    }

    .btn-secondary {
      background: white;
      border-color: var(--border-color);
      color: var(--text-dark);
    }
    .btn-secondary:hover {
      background: var(--bg-main);
    }

    .btn-danger {
      background-color: var(--red-alert);
      color: white;
    }

    .btn-sm {
      padding: 6px 12px;
      font-size: 12px;
    }

    /* TABLE DESIGN */
    .table-container {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    th {
      padding: 14px 16px;
      border-bottom: 1px solid var(--border-color);
      color: var(--text-muted);
      font-weight: 600;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    td {
      padding: 16px;
      border-bottom: 1px solid var(--border-color);
      vertical-align: middle;
    }

    tr:last-child td {
      border-bottom: none;
    }

    /* BADGES */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
    }

    .badge-pending { background: var(--yellow-bg); color: var(--yellow-alert); }
    .badge-approved { background: var(--light-green); color: var(--primary-green); }
    .badge-rejected { background: var(--red-bg); color: var(--red-alert); }
    .badge-connected { background: var(--light-green); color: var(--primary-green); }
    .badge-available { background: var(--blue-bg); color: var(--blue-info); }

    /* MODAL */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.4);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
    }

    .modal-overlay.active {
      display: flex;
    }

    .modal-box {
      background: white;
      border-radius: var(--radius);
      width: 100%;
      max-width: 480px;
      padding: 24px;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }

    .modal-header h3 {
      font-size: 18px;
      font-weight: 700;
    }

    .modal-footer {
      display: flex;
      justify-content: flex-end;
      gap: 12px;
      margin-top: 24px;
    }

    /* UTILS */
    .flex-between { display: flex; justify-content: space-between; align-items: center; }
    .flex-gap { display: flex; gap: 12px; align-items: center; }
    .text-muted { color: var(--text-muted); }
  </style>
</head>
<body>

  <!-- 0. LOGIN SCREEN (SIMULATED) -->
  <div id="login-screen">
    <div class="login-card">
      <div class="login-brand">
        <i class="fa-solid fa-wheat-awn"></i>
        <h1>Smart Mill Admin</h1>
      </div>
      <p class="text-muted" style="margin-bottom: 24px;">Sign in to manage system access, users & gateways.</p>
      
      <form onsubmit="handleLogin(event)">
        <div class="form-group">
          <label>Admin Email</label>
          <input type="email" value="admin@smartmill.com" required>
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" value="••••••••" required>
        </div>
        <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 12px;">Sign In to Portal</button>
      </form>
    </div>
  </div>

  <!-- APP LAYOUT -->
  <aside>
    <div>
      <div class="sidebar-header">
        <i class="fa-solid fa-wheat-awn"></i>
        <h2>Smart Mill</h2>
      </div>

      <div class="nav-group">
        <div class="nav-label">Main Menu</div>
        
        <div class="nav-item active" onclick="switchNav('dashboard', this)">
          <div class="nav-item-left">
            <i class="fa-solid fa-chart-pie"></i>
            <span>Dashboard</span>
          </div>
        </div>

        <div class="nav-item" onclick="switchNav('approvals', this)">
          <div class="nav-item-left">
            <i class="fa-solid fa-user-check"></i>
            <span>User Approvals</span>
          </div>
          <span class="badge-count" id="nav-pending-badge">3</span>
        </div>

        <div class="nav-item" onclick="switchNav('assignment', this)">
          <div class="nav-item-left">
            <i class="fa-solid fa-network-wired"></i>
            <span>Gateway Assignment</span>
          </div>
        </div>

        <div class="nav-item" onclick="switchNav('connections', this)">
          <div class="nav-item-left">
            <i class="fa-solid fa-link"></i>
            <span>Active Connections</span>
          </div>
        </div>
      </div>

      <div class="nav-group">
        <div class="nav-label">System Audit</div>

        <div class="nav-item" onclick="switchNav('profile', this)">
          <div class="nav-item-left">
            <i class="fa-solid fa-user-gear"></i>
            <span>Admin Profile</span>
          </div>
        </div>

        <div class="nav-item" onclick="switchNav('logs', this)">
          <div class="nav-item-left">
            <i class="fa-solid fa-clock-rotate-left"></i>
            <span>Activity Log</span>
          </div>
        </div>
      </div>
    </div>

    <div style="padding: 16px; border-top: 1px solid var(--border-color);">
      <button class="btn btn-secondary" onclick="logout()" style="width: 100%; justify-content: center;">
        <i class="fa-solid fa-arrow-right-from-bracket"></i> Sign Out
      </button>
    </div>
  </aside>

  <main>
    <header>
      <div class="header-title" id="page-title">Dashboard Overview</div>
      <div class="admin-pill">
        <div class="avatar">AD</div>
        <div>
          <div style="font-weight: 600; font-size: 13px;">System Admin</div>
          <div style="font-size: 11px; color: var(--text-muted);">ADM-001 (Super Admin)</div>
        </div>
      </div>
    </header>

    <div class="content-area">

      <!-- 1. DASHBOARD VIEW -->
      <div id="dashboard-view" class="view-page active">
        <div class="metrics-grid">
          <div class="metric-card highlight">
            <div class="metric-header">
              <span>Pending Approvals</span>
              <i class="fa-solid fa-user-clock" style="color: var(--yellow-alert);"></i>
            </div>
            <div class="metric-val" id="kpi-pending">3</div>
            <div class="metric-sub">Action required from admin</div>
          </div>

          <div class="metric-card">
            <div class="metric-header">
              <span>Approved Users</span>
              <i class="fa-solid fa-user-check" style="color: var(--primary-green);"></i>
            </div>
            <div class="metric-val" id="kpi-approved">5</div>
            <div class="metric-sub">Eligible for gateway access</div>
          </div>

          <div class="metric-card">
            <div class="metric-header">
              <span>Registered Gateways</span>
              <i class="fa-solid fa-server" style="color: var(--blue-info);"></i>
            </div>
            <div class="metric-val" id="kpi-gateways">6</div>
            <div class="metric-sub"><span id="kpi-avail-gateways">4</span> available for connection</div>
          </div>

          <div class="metric-card">
            <div class="metric-header">
              <span>Active Connections</span>
              <i class="fa-solid fa-link" style="color: var(--primary-green);"></i>
            </div>
            <div class="metric-val" id="kpi-connections">2</div>
            <div class="metric-sub">Currently linked sessions</div>
          </div>
        </div>

        <div class="card">
          <div class="flex-between" style="margin-bottom: 20px;">
            <h3>Quick Actions</h3>
          </div>
          <div class="flex-gap">
            <button class="btn btn-primary" onclick="switchNav('approvals', document.querySelectorAll('.nav-item')[1])">
              <i class="fa-solid fa-user-check"></i> Review Pending Approvals
            </button>
            <button class="btn btn-secondary" onclick="openAssignModal()">
              <i class="fa-solid fa-plus"></i> Assign New Gateway
            </button>
          </div>
        </div>

        <div class="card">
          <h3 style="margin-bottom: 16px;">Recent Admin Activity</h3>
          <div class="table-container">
            <table>
              <thead>
                <tr>
                  <th>Timestamp</th>
                  <th>Action</th>
                  <th>Description</th>
                  <th>Admin ID</th>
                </tr>
              </thead>
              <tbody id="dash-recent-logs">
                <!-- JS populated -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- 2. USER APPROVAL VIEW -->
      <div id="approvals-view" class="view-page">
        <div class="card">
          <div class="flex-between" style="margin-bottom: 20px;">
            <div>
              <h3>Registration Approvals</h3>
              <p class="text-muted">Approve or reject new user registration requests before assigning hardware.</p>
            </div>
          </div>

          <div class="table-container">
            <table>
              <thead>
                <tr>
                  <th>User Details</th>
                  <th>Phone Number</th>
                  <th>Registered Date</th>
                  <th>Status</th>
                  <th style="text-align: right;">Action</th>
                </tr>
              </thead>
              <tbody id="approvals-table-body">
                <!-- JS populated -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- 3. GATEWAY ASSIGNMENT VIEW -->
      <div id="assignment-view" class="view-page">
        <div class="card">
          <div class="flex-between" style="margin-bottom: 20px;">
            <div>
              <h3>Gateway Assignments</h3>
              <p class="text-muted">Map hardware gateways to approved users. One active gateway per user constraint applies.</p>
            </div>
            <button class="btn btn-primary" onclick="openAssignModal()">
              <i class="fa-solid fa-plus"></i> Assign Gateway
            </button>
          </div>

          <div class="table-container">
            <table>
              <thead>
                <tr>
                  <th>Gateway ID</th>
                  <th>Location</th>
                  <th>Current Status</th>
                  <th>Assigned User</th>
                  <th style="text-align: right;">Action</th>
                </tr>
              </thead>
              <tbody id="assignment-table-body">
                <!-- JS populated -->
              </tbody>
            </table>
          </div>
        </div>

        <div class="card">
          <h3 style="margin-bottom: 16px;">Assignment & Release History</h3>
          <div class="table-container">
            <table>
              <thead>
                <tr>
                  <th>Date & Time</th>
                  <th>Gateway ID</th>
                  <th>User Name</th>
                  <th>Action Record</th>
                </tr>
              </thead>
              <tbody id="history-table-body">
                <!-- JS populated -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- 4. ACTIVE CONNECTIONS VIEW -->
      <div id="connections-view" class="view-page">
        <div class="card">
          <div class="flex-between" style="margin-bottom: 20px;">
            <div>
              <h3>Active Gateway Connections</h3>
              <p class="text-muted">Monitor and safely disconnect live hardware links.</p>
            </div>
          </div>

          <div class="table-container">
            <table>
              <thead>
                <tr>
                  <th>Connection ID</th>
                  <th>Gateway ID</th>
                  <th>Assigned Approved User</th>
                  <th>Connected Since</th>
                  <th>Connection Status</th>
                  <th style="text-align: right;">Action</th>
                </tr>
              </thead>
              <tbody id="connections-table-body">
                <!-- JS populated -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- 5. ADMIN PROFILE VIEW -->
      <div id="profile-view" class="view-page">
        <div class="card" style="max-width: 600px;">
          <h3 style="margin-bottom: 20px;">Admin Account Profile</h3>
          
          <div class="form-group">
            <label>Admin ID</label>
            <input type="text" value="ADM-001" disabled style="background: var(--bg-main);">
          </div>

          <div class="form-group">
            <label>Full Name</label>
            <input type="text" id="admin-name-input" value="System Administrator">
          </div>

          <div class="form-group">
            <label>Email Address</label>
            <input type="email" id="admin-email-input" value="admin@smartmill.com">
          </div>

          <div class="form-group">
            <label>Role</label>
            <input type="text" value="Super Admin (Gateways & Approvals)" disabled style="background: var(--bg-main);">
          </div>

          <button class="btn btn-primary" onclick="saveProfile()">Save Profile Changes</button>
        </div>
      </div>

      <!-- 6. ACTIVITY LOG VIEW -->
      <div id="logs-view" class="view-page">
        <div class="card">
          <div class="flex-between" style="margin-bottom: 20px;">
            <div>
              <h3>Audit Trail Log</h3>
              <p class="text-muted">Immutable history of all approval, assignment, and disconnection operations.</p>
            </div>
          </div>

          <div class="table-container">
            <table>
              <thead>
                <tr>
                  <th>Timestamp</th>
                  <th>Admin ID</th>
                  <th>Action Type</th>
                  <th>Detailed Log Description</th>
                </tr>
              </thead>
              <tbody id="full-logs-body">
                <!-- JS populated -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </main>

  <!-- MODALS -->

  <!-- REJECT REASON MODAL -->
  <div class="modal-overlay" id="modal-reject">
    <div class="modal-box">
      <div class="modal-header">
        <h3>Reject User Registration</h3>
        <i class="fa-solid fa-xmark" onclick="closeModal('modal-reject')" style="cursor: pointer;"></i>
      </div>
      <p class="text-muted" style="margin-bottom: 16px;">Please specify a reason for rejecting this user registration.</p>
      
      <div class="form-group">
        <label>Reason for Rejection</label>
        <textarea id="reject-reason-input" rows="3" placeholder="e.g., Incomplete documentation, Invalid contact details..."></textarea>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeModal('modal-reject')">Cancel</button>
        <button class="btn btn-danger" onclick="confirmReject()">Confirm Rejection</button>
      </div>
    </div>
  </div>

  <!-- ASSIGN GATEWAY MODAL -->
  <div class="modal-overlay" id="modal-assign">
    <div class="modal-box">
      <div class="modal-header">
        <h3>Assign Gateway to User</h3>
        <i class="fa-solid fa-xmark" onclick="closeModal('modal-assign')" style="cursor: pointer;"></i>
      </div>
      
      <div class="form-group">
        <label>Select Approved User</label>
        <select id="assign-user-select">
          <!-- JS Populated: Only Approved Users -->
        </select>
      </div>

      <div class="form-group">
        <label>Select Available Gateway</label>
        <select id="assign-gateway-select">
          <!-- JS Populated: Only Available Gateways -->
        </select>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeModal('modal-assign')">Cancel</button>
        <button class="btn btn-primary" onclick="confirmAssign()">Confirm & Connect</button>
      </div>
    </div>
  </div>

  <!-- DISCONNECT CONFIRM MODAL -->
  <div class="modal-overlay" id="modal-disconnect">
    <div class="modal-box">
      <div class="modal-header">
        <h3>Disconnect Gateway</h3>
        <i class="fa-solid fa-xmark" onclick="closeModal('modal-disconnect')" style="cursor: pointer;"></i>
      </div>
      <p style="margin-bottom: 16px;">Are you sure you want to disconnect gateway <strong id="disc-gw-id"></strong> from user <strong id="disc-user-name"></strong>?</p>
      <p class="text-muted">This will terminate the session and return the gateway to Available status.</p>

      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeModal('modal-disconnect')">Cancel</button>
        <button class="btn btn-danger" onclick="confirmDisconnect()">Disconnect Now</button>
      </div>
    </div>
  </div>

  <!-- JAVASCRIPT LOGIC -->
  <script>
    // INITIAL STATE & DATA MODEL
    let currentAdmin = { id: 'ADM-001', name: 'System Administrator', email: 'admin@smartmill.com' };

    let users = [
      { id: 'USR-001', name: 'Rajesh Kumar', email: 'rajesh@paddytraders.com', phone: '+91 98765 43210', registeredOn: '2025-02-24 10:15', status: 'pending' },
      { id: 'USR-002', name: 'Sunil Sharma', email: 'sunil@ricemill.in', phone: '+91 98123 45678', registeredOn: '2025-02-24 11:30', status: 'pending' },
      { id: 'USR-003', name: 'Amit Patel', email: 'amit@patelgrains.com', phone: '+91 97111 22334', registeredOn: '2025-02-23 14:20', status: 'pending' },
      { id: 'USR-004', name: 'Vikram Singh', email: 'vikram@singhmills.com', phone: '+91 99000 11223', registeredOn: '2025-02-20 09:00', status: 'approved' },
      { id: 'USR-005', name: 'Suresh Reddy', email: 'suresh@deccanrice.com', phone: '+91 98444 55667', registeredOn: '2025-02-18 16:45', status: 'approved' },
      { id: 'USR-006', name: 'Priya Nair', email: 'priya@keralagrains.io', phone: '+91 94470 12345', registeredOn: '2025-02-15 12:10', status: 'approved' },
      { id: 'USR-007', name: 'Anil Verma', email: 'anil@vermamilling.com', phone: '+91 93123 99887', registeredOn: '2025-02-10 08:30', status: 'approved' },
      { id: 'USR-008', name: 'Mahesh Joshi', email: 'mahesh@joshiagro.com', phone: '+91 92000 33445', registeredOn: '2025-02-05 15:00', status: 'approved' },
      { id: 'USR-009', name: 'Karan Mehta', email: 'karan@invalid.com', phone: '+91 91111 00000', registeredOn: '2025-02-01 11:00', status: 'rejected', rejectReason: 'Invalid Phone Number' }
    ];

    let gateways = [
      { id: 'GW-001', location: 'Mill Floor - Sector A', status: 'connected', assignedUserId: 'USR-004' },
      { id: 'GW-002', location: 'Processing Unit - Line 2', status: 'connected', assignedUserId: 'USR-005' },
      { id: 'GW-003', location: 'Storage Warehouse B', status: 'available', assignedUserId: null },
      { id: 'GW-004', location: 'Dryer Unit 1', status: 'available', assignedUserId: null },
      { id: 'GW-005', location: 'Packaging Bay', status: 'available', assignedUserId: null },
      { id: 'GW-006', location: 'Main Intake Hoppers', status: 'available', assignedUserId: null }
    ];

    let connections = [
      { id: 'CON-101', userId: 'USR-004', gatewayId: 'GW-001', connectedAt: '2025-02-21 10:00', status: 'active' },
      { id: 'CON-102', userId: 'USR-005', gatewayId: 'GW-002', connectedAt: '2025-02-22 14:30', status: 'active' }
    ];

    let assignmentHistory = [
      { date: '2025-02-21 10:00', gatewayId: 'GW-001', userId: 'USR-004', status: 'active' },
      { date: '2025-02-22 14:30', gatewayId: 'GW-002', userId: 'USR-005', status: 'active' }
    ];

    let activityLogs = [
      { id: 'LOG-001', timestamp: '2025-02-24 12:00', adminId: 'ADM-001', action: 'LOGIN', description: 'Admin logged into portal' },
      { id: 'LOG-002', timestamp: '2025-02-22 14:30', adminId: 'ADM-001', action: 'GATEWAY_ASSIGNED', description: 'Assigned GW-002 to Suresh Reddy (USR-005)' },
      { id: 'LOG-003', timestamp: '2025-02-21 10:00', adminId: 'ADM-001', action: 'GATEWAY_ASSIGNED', description: 'Assigned GW-001 to Vikram Singh (USR-004)' },
      { id: 'LOG-004', timestamp: '2025-02-20 09:05', adminId: 'ADM-001', action: 'USER_APPROVED', description: 'Approved user Vikram Singh (USR-004)' }
    ];

    // TEMP TARGET RETENTION FOR MODALS
    let selectedUserId = null;
    let selectedGatewayId = null;

    // INIT APP
    window.onload = function() {
      renderAll();
    };

    function handleLogin(e) {
      e.preventDefault();
      document.getElementById('login-screen').style.display = 'none';
      logActivity('LOGIN', 'Admin authenticated');
      renderAll();
    }

    function logout() {
      document.getElementById('login-screen').style.display = 'flex';
      logActivity('LOGOUT', 'Admin signed out');
    }

    // NAVIGATION SYSTEM
    function switchNav(viewId, element) {
      document.querySelectorAll('.view-page').forEach(v => v.classList.remove('active'));
      document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));

      document.getElementById(viewId + '-view').classList.add('active');
      if (element) element.classList.add('active');

      const titles = {
        'dashboard': 'Dashboard Overview',
        'approvals': 'User Approval Management',
        'assignment': 'Gateway Assignment',
        'connections': 'Active Connections',
        'profile': 'Admin Profile',
        'logs': 'System Activity Log'
      };
      document.getElementById('page-title').innerText = titles[viewId] || 'Admin Portal';
      renderAll();
    }

    // LOGGING UTILITY
    function logActivity(action, description) {
      const log = {
        id: 'LOG-' + String(activityLogs.length + 1).padStart(3, '0'),
        timestamp: new Date().toISOString().replace('T', ' ').substring(0, 16),
        adminId: currentAdmin.id,
        action: action,
        description: description
      };
      activityLogs.unshift(log);
    }

    // MAIN RENDER CONTROLLER
    function renderAll() {
      renderDashboard();
      renderApprovals();
      renderAssignments();
      renderConnections();
      renderLogs();
    }

    // 1. DASHBOARD RENDER
    function renderDashboard() {
      const pendingCount = users.filter(u => u.status === 'pending').length;
      const approvedCount = users.filter(u => u.status === 'approved').length;
      const availGwCount = gateways.filter(g => g.status === 'available').length;
      const activeConnCount = connections.filter(c => c.status === 'active').length;

      document.getElementById('kpi-pending').innerText = pendingCount;
      document.getElementById('nav-pending-badge').innerText = pendingCount;
      document.getElementById('kpi-approved').innerText = approvedCount;
      document.getElementById('kpi-gateways').innerText = gateways.length;
      document.getElementById('kpi-avail-gateways').innerText = availGwCount;
      document.getElementById('kpi-connections').innerText = activeConnCount;

      const recentLogsTbody = document.getElementById('dash-recent-logs');
      recentLogsTbody.innerHTML = activityLogs.slice(0, 5).map(l => `
        <tr>
          <td class="text-muted">${l.timestamp}</td>
          <td><span class="badge badge-approved" style="font-size:11px;">${l.action}</span></td>
          <td>${l.description}</td>
          <td><strong>${l.adminId}</strong></td>
        </tr>
      `).join('');
    }

    // 2. APPROVALS RENDER & ACTIONS
    function renderApprovals() {
      const tbody = document.getElementById('approvals-table-body');
      tbody.innerHTML = users.map(u => {
        let badge = `<span class="badge badge-${u.status}">${u.status.toUpperCase()}</span>`;
        let actionBtn = '';

        if (u.status === 'pending') {
          actionBtn = `
            <button class="btn btn-primary btn-sm" onclick="approveUser('${u.id}')"><i class="fa-solid fa-check"></i> Approve</button>
            <button class="btn btn-secondary btn-sm" onclick="openRejectModal('${u.id}')" style="color:var(--red-alert);"><i class="fa-solid fa-xmark"></i> Reject</button>
          `;
        } else if (u.status === 'rejected') {
          actionBtn = `<span class="text-muted" style="font-size:12px;">Reason: ${u.rejectReason || 'N/A'}</span>`;
        } else {
          actionBtn = `<span class="text-muted" style="font-size:12px;"><i class="fa-solid fa-circle-check" style="color:var(--primary-green);"></i> Ready for Gateway</span>`;
        }

        return `
          <tr>
            <td>
              <div style="font-weight:600;">${u.name}</div>
              <div class="text-muted" style="font-size:12px;">${u.email} (${u.id})</div>
            </td>
            <td>${u.phone}</td>
            <td class="text-muted">${u.registeredOn}</td>
            <td>${badge}</td>
            <td style="text-align: right;">${actionBtn}</td>
          </tr>
        `;
      }).join('');
    }

    function approveUser(userId) {
      const user = users.find(u => u.id === userId);
      if (user) {
        user.status = 'approved';
        logActivity('USER_APPROVED', `Approved registration for ${user.name} (${user.id})`);
        renderAll();
      }
    }

    function openRejectModal(userId) {
      selectedUserId = userId;
      document.getElementById('reject-reason-input').value = '';
      document.getElementById('modal-reject').classList.add('active');
    }

    function confirmReject() {
      const reason = document.getElementById('reject-reason-input').value.trim();
      if (!reason) {
        alert('Please enter a rejection reason.');
        return;
      }
      const user = users.find(u => u.id === selectedUserId);
      if (user) {
        user.status = 'rejected';
        user.rejectReason = reason;
        logActivity('USER_REJECTED', `Rejected ${user.name} (${user.id}). Reason: ${reason}`);
        closeModal('modal-reject');
        renderAll();
      }
    }

    // 3. ASSIGNMENT RENDER & ACTIONS
    function renderAssignments() {
      const tbody = document.getElementById('assignment-table-body');
      tbody.innerHTML = gateways.map(g => {
        const assignedUser = users.find(u => u.id === g.assignedUserId);
        const statusBadge = g.status === 'connected' 
          ? `<span class="badge badge-connected">CONNECTED</span>`
          : `<span class="badge badge-available">AVAILABLE</span>`;

        const actionBtn = g.status === 'connected'
          ? `<button class="btn btn-secondary btn-sm" onclick="openDisconnectModal('${g.id}')" style="color:var(--red-alert);"><i class="fa-solid fa-power-off"></i> Disconnect</button>`
          : `<button class="btn btn-primary btn-sm" onclick="openAssignModalForGateway('${g.id}')"><i class="fa-solid fa-link"></i> Assign User</button>`;

        return `
          <tr>
            <td><strong>${g.id}</strong></td>
            <td>${g.location}</td>
            <td>${statusBadge}</td>
            <td>${assignedUser ? `<strong>${assignedUser.name}</strong> (${assignedUser.id})` : '<span class="text-muted">Unassigned</span>'}</td>
            <td style="text-align: right;">${actionBtn}</td>
          </tr>
        `;
      }).join('');

      // Populate Assignment History Table
      const histBody = document.getElementById('history-table-body');
      histBody.innerHTML = assignmentHistory.map(h => {
        const user = users.find(u => u.id === h.userId);
        return `
          <tr>
            <td class="text-muted">${h.date}</td>
            <td><strong>${h.gatewayId}</strong></td>
            <td>${user ? user.name : h.userId}</td>
            <td><span class="badge badge-${h.status === 'active' ? 'approved' : 'rejected'}">${h.status.toUpperCase()}</span></td>
          </tr>
        `;
      }).join('');
    }

    function openAssignModal() {
      populateAssignDropdowns();
      document.getElementById('modal-assign').classList.add('active');
    }

    function openAssignModalForGateway(gwId) {
      populateAssignDropdowns();
      document.getElementById('assign-gateway-select').value = gwId;
      document.getElementById('modal-assign').classList.add('active');
    }

    function populateAssignDropdowns() {
      const userSelect = document.getElementById('assign-user-select');
      const gwSelect = document.getElementById('assign-gateway-select');

      // Strict requirement: Only Approved Users
      const approvedUsers = users.filter(u => u.status === 'approved');
      if (approvedUsers.length === 0) {
        userSelect.innerHTML = `<option value="">No Approved Users Available</option>`;
      } else {
        userSelect.innerHTML = approvedUsers.map(u => `<option value="${u.id}">${u.name} (${u.id})</option>`).join('');
      }

      // Available Gateways Only
      const availGateways = gateways.filter(g => g.status === 'available');
      if (availGateways.length === 0) {
        gwSelect.innerHTML = `<option value="">No Available Gateways</option>`;
      } else {
        gwSelect.innerHTML = availGateways.map(g => `<option value="${g.id}">${g.id} - ${g.location}</option>`).join('');
      }
    }

    function confirmAssign() {
      const userId = document.getElementById('assign-user-select').value;
      const gwId = document.getElementById('assign-gateway-select').value;

      if (!userId || !gwId) {
        alert('Please select both an approved user and an available gateway.');
        return;
      }

      const gateway = gateways.find(g => g.id === gwId);
      const user = users.find(u => u.id === userId);

      // Business Rule: 1 Gateway = 1 Active User
      gateway.status = 'connected';
      gateway.assignedUserId = userId;

      // Add active connection
      const connId = 'CON-' + Math.floor(100 + Math.random() * 900);
      const timeStr = new Date().toISOString().replace('T', ' ').substring(0, 16);

      connections.unshift({
        id: connId,
        userId: userId,
        gatewayId: gwId,
        connectedAt: timeStr,
        status: 'active'
      });

      assignmentHistory.unshift({
        date: timeStr,
        gatewayId: gwId,
        userId: userId,
        status: 'active'
      });

      logActivity('GATEWAY_ASSIGNED', `Assigned ${gwId} to ${user.name} (${userId})`);
      logActivity('CONNECTION_ESTABLISHED', `Connection ${connId} established for ${gwId}`);

      closeModal('modal-assign');
      renderAll();
    }

    // 4. CONNECTIONS RENDER & DISCONNECT
    function renderConnections() {
      const tbody = document.getElementById('connections-table-body');
      const activeConns = connections.filter(c => c.status === 'active');

      if (activeConns.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="text-muted" style="text-align:center; padding: 24px;">No active gateway connections currently running.</td></tr>`;
        return;
      }

      tbody.innerHTML = activeConns.map(c => {
        const user = users.find(u => u.id === c.userId);
        return `
          <tr>
            <td><strong>${c.id}</strong></td>
            <td>${c.gatewayId}</td>
            <td><strong>${user ? user.name : c.userId}</strong> (${c.userId})</td>
            <td class="text-muted">${c.connectedAt}</td>
            <td><span class="badge badge-connected"><i class="fa-solid fa-signal" style="font-size:10px;"></i> ACTIVE</span></td>
            <td style="text-align: right;">
              <button class="btn btn-secondary btn-sm" onclick="openDisconnectModal('${c.gatewayId}')" style="color:var(--red-alert);">
                <i class="fa-solid fa-power-off"></i> Disconnect
              </button>
            </td>
          </tr>
        `;
      }).join('');
    }

    function openDisconnectModal(gwId) {
      selectedGatewayId = gwId;
      const gw = gateways.find(g => g.id === gwId);
      const user = users.find(u => u.id === gw.assignedUserId);

      document.getElementById('disc-gw-id').innerText = gwId;
      document.getElementById('disc-user-name').innerText = user ? user.name : 'Assigned User';
      document.getElementById('modal-disconnect').classList.add('active');
    }

    function confirmDisconnect() {
      const gw = gateways.find(g => g.id === selectedGatewayId);
      const user = users.find(u => u.id === gw.assignedUserId);

      // Release gateway
      gw.status = 'available';
      gw.assignedUserId = null;

      // Close active connection
      const conn = connections.find(c => c.gatewayId === selectedGatewayId && c.status === 'active');
      if (conn) {
        conn.status = 'disconnected';
      }

      const timeStr = new Date().toISOString().replace('T', ' ').substring(0, 16);
      assignmentHistory.unshift({
        date: timeStr,
        gatewayId: selectedGatewayId,
        userId: user ? user.id : 'N/A',
        status: 'released'
      });

      logActivity('GATEWAY_DISCONNECTED', `Disconnected ${selectedGatewayId} from user ${user ? user.name : 'Unknown'}`);

      closeModal('modal-disconnect');
      renderAll();
    }

    // 5. PROFILE SAVE
    function saveProfile() {
      currentAdmin.name = document.getElementById('admin-name-input').value;
      currentAdmin.email = document.getElementById('admin-email-input').value;
      logActivity('PROFILE_UPDATE', 'Admin updated profile details');
      alert('Admin profile updated successfully.');
    }

    // 6. LOGS RENDER
    function renderLogs() {
      const tbody = document.getElementById('full-logs-body');
      tbody.innerHTML = activityLogs.map(l => `
        <tr>
          <td class="text-muted">${l.timestamp}</td>
          <td><strong>${l.adminId}</strong></td>
          <td><span class="badge badge-approved">${l.action}</span></td>
          <td>${l.description}</td>
        </tr>
      `).join('');
    }

    // MODAL HELPERS
    function closeModal(modalId) {
      document.getElementById(modalId).classList.remove('active');
    }
  </script>
</body>
